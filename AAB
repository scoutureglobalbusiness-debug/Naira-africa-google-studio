name: Build Release AAB

on:
  push:
    branches: [ main ]
  workflow_dispatch: {}

jobs:
  build-release:
    name: Build signed AAB (CI)
    runs-on: ubuntu-latest
    env:
      KEYSTORE_PATH: ./my-upload-key.jks
      KEY_ALIAS: upload
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 11
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '11'
          cache: 'gradle'

      - name: Install Android SDK components
        uses: android-actions/setup-sdk@v2
        with:
          api-levels: '36'
          build-tools: '36.0.0'
          components: |
            platform-tools
            build-tools;36.0.0
            platforms;android-36

      - name: Decode keystore from secret
        if: secrets.KEYSTORE_BASE64
        run: |
          echo "Decoding keystore into ${KEYSTORE_PATH}"
          echo "$KEYSTORE_BASE64" | base64 --decode > "$KEYSTORE_PATH"
          chmod 600 "$KEYSTORE_PATH"
        shell: bash

      - name: Write .env from secrets
        env:
          STORE_PASSWORD: ${{ secrets.STORE_PASSWORD }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          if [ -z "${STORE_PASSWORD:-}" ] || [ -z "${KEY_PASSWORD:-}" ]; then
            echo "Missing STORE_PASSWORD or KEY_PASSWORD; set repository secrets before running this workflow." >&2
            exit 1
          fi
          cat > .env <<EOF
KEYSTORE_PATH=${{ env.KEYSTORE_PATH }}
STORE_PASSWORD=${STORE_PASSWORD}
KEY_PASSWORD=${KEY_PASSWORD}
EOF
          chmod 600 .env
        shell: bash

      - name: Grant execute to gradlew
        run: chmod +x ./gradlew

      - name: Build release AAB
        run: ./gradlew clean bundleRelease --no-daemon --console=plain

      - name: Upload AAB artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release-aab
          path: app/build/outputs/bundle/release/app-release.aab

      - name: Upload APK artifact (optional)
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: app/build/outputs/apk/release/app-release.apk
